params.skip_calling = false   // true = FASTP -> BWA_MEM2 -> MARKDUP only
params.outdir = "results"

manifest {
    name        = 'germline-mini'
    description = 'FASTQ -> DeepVariant VCF -> hap.py vs GIAB'
    version     = '0.1.0'
}
profiles {
    docker {
        docker.enabled = true
        docker.runOptions = '-u $(id -u):$(id -g)'        // output files owned by you, not root
        process.resourceLimits = [cpus: 4, memory: 8.GB]   // fit your laptop (nproc, free -g)
    }
    test {
        params.samplesheet = "${projectDir}/tests/data/samplesheet.csv"
        params.fasta       = "${projectDir}/tests/data/ref.fa"
        params.truth_vcf   = "${projectDir}/tests/data/truth.vcf.gz"
        params.truth_bed   = "${projectDir}/tests/data/truth.bed"
        process.resourceLimits = [cpus: 2, memory: 4.GB]   // caps cpus/memory on small machines and CI
    }
    awsbatch {
        process.executor = 'awsbatch'
        process.queue    = 'my-batch-queue'      // your AWS Batch job queue
        aws.region       = 'us-east-1'
        workDir          = 's3://my-bucket/work'  // must be S3 for awsbatch
    }
}
trace    { enabled = true; file = "${params.outdir}/pipeline_info/trace.txt"; overwrite = true }
report   { enabled = true; file = "${params.outdir}/pipeline_info/report.html"; overwrite = true }
timeline { enabled = true; file = "${params.outdir}/pipeline_info/timeline.html"; overwrite = true }
